<!--
  Setup.vbproj - builds the Windows installer (Release configuration only).
  1. Publishes the app self-contained for win-x64 into Setup\publish\
  2. Compiles Setup.iss with the Inno Setup compiler from the Tools.InnoSetup
     NuGet package into CarveMaker-Setup-<version>.exe in the solution root
  No Visual Studio extension is required; "dotnet build -c Release" or a
  Release build in Visual Studio produces the installer.
-->
<Project Sdk="Microsoft.Build.NoTargets/3.7.134">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AppProject>$(MSBuildThisFileDirectory)..\CarveMaker.vbproj</AppProject>
    <PublishDir>$(MSBuildThisFileDirectory)publish\</PublishDir>
    <InstallerDir>$(MSBuildThisFileDirectory)..\</InstallerDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build order only: the installer never references the app assembly. -->
    <ProjectReference Include="..\CarveMaker.vbproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="Tools.InnoSetup" Version="6.7.3" GeneratePathProperty="true" />
    <None Include="Setup.iss" />
  </ItemGroup>

  <Target Name="BuildInstaller" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="high" Text="Publishing $(AppProject) (self-contained win-x64) to $(PublishDir)" />
    <RemoveDir Directories="$(PublishDir)" />
    <MSBuild Projects="$(AppProject)" Targets="Publish"
             Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishDir=$(PublishDir);Version=$(Version)" />
    <Error Condition="!Exists('$(PkgTools_InnoSetup)\tools\ISCC.exe')" Text="Inno Setup compiler not found at $(PkgTools_InnoSetup)\tools\ISCC.exe (restore the Tools.InnoSetup package)." />
    <MakeDir Directories="$(InstallerDir)" />
    <Exec Command="&quot;$(PkgTools_InnoSetup)\tools\ISCC.exe&quot; /Q /DAppVersion=$(Version) &quot;/DSourceDir=$(PublishDir.TrimEnd('\'))&quot; &quot;/DOutputDir=$(InstallerDir.TrimEnd('\'))&quot; &quot;$(MSBuildThisFileDirectory)Setup.iss&quot;" />
    <Message Importance="high" Text="Installer written to $(InstallerDir)CarveMaker-Setup-$(Version).exe" />
  </Target>

</Project>
